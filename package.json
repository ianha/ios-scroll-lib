{
  "name": "ios-scroll",
  "version": "0.1.0",
  "description": "iOS-style rubber banding, momentum and interruptible springs for the web. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./physics": {
      "import": {
        "types": "./dist/physics.d.ts",
        "default": "./dist/physics.js"
      },
      "require": {
        "types": "./dist/physics.d.cts",
        "default": "./dist/physics.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:lib && npm run build:example",
    "build:lib": "tsup",
    "build:example": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "prepack": "npm run build:lib",
    "test:package": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "scroll",
    "ios",
    "rubber-band",
    "momentum",
    "spring",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
